{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Megh Template (injection)",
  "scopeName": "text.html.megh.injection",
  "comment": "Generated by scripts/build-grammar.mjs; edit that file. Injected into every scope of text.html.megh (attribute values, <script>, <style>) except Megh's own embedded code and comments.",
  "injectionSelector": "L:text.html.megh -meta.embedded.megh -comment.block.megh",
  "patterns": [
    {
      "include": "#escapes"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#raw-echo"
    },
    {
      "include": "#echo"
    },
    {
      "include": "#js-block"
    },
    {
      "include": "#react-block"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#bound-attribute"
    }
  ],
  "repository": {
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.megh",
          "match": "@\\{\\{"
        },
        {
          "name": "constant.character.escape.megh",
          "match": "@@"
        }
      ]
    },
    "comment": {
      "name": "comment.block.megh",
      "begin": "\\{\\{--",
      "end": "--\\}\\}",
      "captures": {
        "0": {
          "name": "punctuation.definition.comment.megh"
        }
      }
    },
    "raw-echo": {
      "name": "meta.echo.raw.megh",
      "begin": "\\{!!",
      "end": "!!\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.megh keyword.operator.raw.megh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.megh keyword.operator.raw.megh"
        }
      },
      "contentName": "meta.embedded.megh.expression source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "echo": {
      "name": "meta.echo.megh",
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.megh"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.megh"
        }
      },
      "contentName": "meta.embedded.megh.expression source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "js-block": {
      "name": "meta.directive.js.megh",
      "begin": "(?<![\\w@.])(@)(js)\\b",
      "end": "(@)(endjs)\\b",
      "captures": {
        "1": {
          "name": "support.function.directive.megh punctuation.definition.directive.megh"
        },
        "2": {
          "name": "support.function.directive.megh"
        }
      },
      "contentName": "meta.embedded.megh.block.js source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "react-block": {
      "name": "meta.directive.react.megh",
      "begin": "(?<![\\w@.])(@)(react)\\b",
      "end": "(@)(endreact)\\b",
      "captures": {
        "1": {
          "name": "support.function.directive.megh punctuation.definition.directive.megh"
        },
        "2": {
          "name": "support.function.directive.megh"
        }
      },
      "patterns": [
        {
          "begin": "\\G\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.arguments.begin.megh"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.megh"
            }
          },
          "contentName": "meta.embedded.megh.arguments source.js",
          "patterns": [
            {
              "include": "#parens"
            },
            {
              "include": "source.js"
            }
          ]
        },
        {
          "begin": "(?<=\\)|react)",
          "end": "(?=@endreact\\b)",
          "contentName": "meta.embedded.megh.block.jsx source.js.jsx",
          "patterns": [
            {
              "include": "source.js.jsx"
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.directive.control.megh",
          "begin": "(?<![\\w@.])(@)(if|elseif|unless|isset|foreach|for|while|session|can|cannot)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.megh punctuation.definition.directive.megh"
            },
            "2": {
              "name": "keyword.control.megh"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.megh"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.megh"
            }
          },
          "contentName": "meta.embedded.megh.arguments source.js",
          "patterns": [
            {
              "include": "#parens"
            },
            {
              "include": "source.js"
            }
          ]
        },
        {
          "name": "meta.directive.builtin.megh",
          "begin": "(?<![\\w@.])(@)(extends|section|yield|include|push|stack|component|slot|json|method)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "support.function.directive.megh punctuation.definition.directive.megh"
            },
            "2": {
              "name": "support.function.directive.megh"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.megh"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.megh"
            }
          },
          "contentName": "meta.embedded.megh.arguments source.js",
          "patterns": [
            {
              "include": "#parens"
            },
            {
              "include": "source.js"
            }
          ]
        },
        {
          "name": "meta.directive.control.megh",
          "match": "(?<![\\w@.])(@)(else|endif|endunless|endisset|endforeach|endfor|endwhile|break|continue|auth|endauth|guest|endguest|endsession|endcan|endcannot)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.control.megh punctuation.definition.directive.megh"
            },
            "2": {
              "name": "keyword.control.megh"
            }
          }
        },
        {
          "name": "meta.directive.builtin.megh",
          "match": "(?<![\\w@.])(@)(endsection|show|parent|endpush|endcomponent|endslot|csrf)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "support.function.directive.megh punctuation.definition.directive.megh"
            },
            "2": {
              "name": "support.function.directive.megh"
            }
          }
        },
        {
          "name": "meta.directive.custom.megh",
          "begin": "(?<![\\w@.])(@)([A-Za-z_]\\w*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.directive.megh punctuation.definition.directive.megh"
            },
            "2": {
              "name": "entity.name.function.directive.megh"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.megh"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.megh"
            }
          },
          "contentName": "meta.embedded.megh.arguments source.js",
          "patterns": [
            {
              "include": "#parens"
            },
            {
              "include": "source.js"
            }
          ]
        }
      ]
    },
    "parens": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "meta.brace.round.js"
        }
      },
      "endCaptures": {
        "0": {
          "name": "meta.brace.round.js"
        }
      },
      "patterns": [
        {
          "include": "#parens"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "bound-attribute": {
      "name": "meta.attribute.bound.megh",
      "begin": "(?<=\\s)(:)([\\w-]+)\\s*(=)\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.attribute-shorthand.bind.megh"
        },
        "2": {
          "name": "entity.other.attribute-name.megh"
        },
        "3": {
          "name": "punctuation.separator.key-value.html"
        },
        "4": {
          "name": "string.quoted.double.html punctuation.definition.string.begin.html"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.html punctuation.definition.string.end.html"
        }
      },
      "contentName": "meta.embedded.megh.expression source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    }
  }
}
