{
  "name": "@meghjs/core",
  "version": "0.5.0",
  "description": "TypeScript-first web framework built on Fastify",
  "author": "Tareq Hossain",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "restapi",
    "megh",
    "backend",
    "fastify",
    "typescript"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "fastify": "^5.1.0",
    "mime": "^3.0.0",
    "node-cron": "^4.2.1",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0"
  },
  "peerDependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@scalar/fastify-api-reference": "^1.0.0",
    "bcryptjs": "^3.0.0",
    "bullmq": ">=5.0.0",
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0",
    "fastify-socket.io": "^4.0.0",
    "ioredis": ">=5.0.0",
    "kafkajs": ">=2.0.0",
    "kysely": ">=0.27.0",
    "pino-pretty": "^13.0.0",
    "sharp": ">=0.33.0",
    "socket.io": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/compress": {
      "optional": true
    },
    "@fastify/cors": {
      "optional": true
    },
    "@fastify/helmet": {
      "optional": true
    },
    "@fastify/multipart": {
      "optional": true
    },
    "@fastify/rate-limit": {
      "optional": true
    },
    "@fastify/static": {
      "optional": true
    },
    "@fastify/swagger": {
      "optional": true
    },
    "@fastify/swagger-ui": {
      "optional": true
    },
    "@scalar/fastify-api-reference": {
      "optional": true
    },
    "bcryptjs": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "fastify-socket.io": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@scalar/fastify-api-reference": "^1.0.0",
    "@swc/core": "^1.16.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "^4.1.12",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.73.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "fastify-socket.io": "^4.0.0",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "kysely": "^0.29.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{js,mjs,ts,json,md}": "prettier --write",
    "*.{js,mjs,ts}": "npm exec -w @meghjs/core -- eslint --fix",
    "*.ts": "npm exec -w @meghjs/core -- vitest related --run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meghjs/megh.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
