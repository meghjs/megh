{
  "name": "@meghjs/cli",
  "version": "0.5.0",
  "description": "CLI for scaffolding and running Megh applications",
  "author": "Tareq Hossain",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "megh": "dist/bin.js"
  },
  "files": [
    "dist",
    "stubs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "watch": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "megh",
    "backend",
    "typescript"
  ],
  "dependencies": {
    "@swc/core": "^1.13.5",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "inquirer": "^12.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@meghjs/core": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "@meghjs/core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meghjs/megh.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
