{
  "name": "blog-orm",
  "version": "0.0.1",
  "private": true,
  "description": "Blog API on the Megh ORM (SQLite): models, relations, migrations, pagination",
  "main": "dist/serve.js",
  "scripts": {
    "start:dev": "megh serve",
    "build": "megh build",
    "start": "megh start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "db:migrate": "megh migrate",
    "db:status": "megh migrate:status",
    "db:fresh": "megh migrate:refresh",
    "db:seed": "megh build && node dist/database/seed.js"
  },
  "keywords": [
    "megh",
    "nodejs",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@meghjs/cli": "file:../../packages/cli",
    "@meghjs/core": "file:../../packages/core",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "kysely": "^0.29.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
