{
  "name": "todo-api",
  "version": "0.0.1",
  "private": true,
  "description": "Todo Api API built with Megh",
  "main": "dist/serve.js",
  "scripts": {
    "start:dev": "megh serve",
    "build": "megh build",
    "start": "megh start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "keywords": [
    "megh",
    "nodejs",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@meghjs/cli": "file:../../packages/cli",
    "@meghjs/core": "file:../../packages/core",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
